# ==============================================================================
# Forma Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Offline Preview Mode (Default for Co-founders & UI Development)
# No database server required. All data is saved on-device / browser via AsyncStorage.
# ------------------------------------------------------------------------------
EXPO_PUBLIC_DATABASE_BACKEND=preview
EXPO_PUBLIC_DEV_PREVIEW=1

# ------------------------------------------------------------------------------
# OPTION 2: CeeBase Custom C++ Database Engine
# Use this when running CeeBase locally or connecting to a shared CeeBase instance.
# Uncomment below and set EXPO_PUBLIC_DATABASE_BACKEND=ceebase to enable.
# ------------------------------------------------------------------------------
# EXPO_PUBLIC_DATABASE_BACKEND=ceebase
# EXPO_PUBLIC_CEEBASE_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# OPTION 3: Supabase (Optional Cloud PostgreSQL)
# ------------------------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
