# Supabase project settings (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Development-only preview data. Never enable for a production build.
# When 1 and no Supabase credentials exist, the app runs with on-device storage
# so the UI can be exercised without fabricating backend success.
EXPO_PUBLIC_DEV_PREVIEW=0
