# Server-side Edge Function secrets. Copy to supabase/.env for local
# `supabase functions serve --env-file supabase/.env`. Never commit real values
# and never place any of these in the iOS app target or an EXPO_PUBLIC_ variable.

# Required for any AI reply or plan generation.
OPENAI_API_KEY=

# Model routing. Tier-specific keys win; OPENAI_MODEL is a Phase 2 fallback for
# the fast and standard tiers only. Reasoning deliberately has its own key.
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_STANDARD=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4o
# OPENAI_MODEL=
# Set to off to force every request onto the standard tier.
AI_MODEL_ROUTING=on

# Embeddings. text-embedding-3-small produces the 1536 dimensions used by the
# schema. Changing the dimension requires a migration (column + RPC).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Live web retrieval. tavily (default), brave, or none. Without a key the coach
# explicitly says it cannot verify current information; it never invents links.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# BRAVE_API_KEY=

# Required by the knowledge-ingest function and scripts/ingest-knowledge.mjs.
KNOWLEDGE_INGEST_SECRET=

# Cost and safety limits (defaults shown).
AI_CHAT_PER_MINUTE=8
AI_CHAT_PER_DAY=150
AI_PLAN_PER_DAY=12
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SIMILARITY_PCT=22
WEB_SEARCH_RESULTS=4
WEB_SEARCH_CACHE_MINUTES=180
WEB_SEARCH_TIMEOUT_MS=8000
KNOWLEDGE_TIMEOUT_MS=9000
AI_CONTEXT_CHAR_BUDGET=16000
AI_HISTORY_MESSAGES=16
AI_MAX_OUTPUT_TOKENS=800
AI_PLAN_STALE_DAYS=42
