<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_card"
        android:orientation="vertical"
        android:padding="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_brand_mark"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.16"
                android:text="@string/widget_brand"
                android:textColor="@color/widget_text_secondary"
                android:textSize="8.5sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_state_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:tint="@color/widget_accent_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textColor="@color/widget_accent_text"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="@font/space_grotesk_bold"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/widget_text" />

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9.5sp" />

        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/widget_cta"
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:background="@drawable/widget_cta"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/widget_cta_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_accent_ink"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/widget_cta_icon"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="5dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:tint="@color/widget_accent_ink" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="126dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/widget_this_week"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="8.5sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_week_fraction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_week_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4.5dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="100"
            android:maxHeight="4.5dp"
            android:minHeight="4.5dp"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_week" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="26dp"
                    android:clipChildren="false">

                    <ProgressBar
                        android:id="@+id/widget_chart_bar_0"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="26dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:maxHeight="8dp"
                        android:minHeight="8dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_chart"
                        android:rotation="-90" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_chart_day_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="26dp"
                    android:clipChildren="false">

                    <ProgressBar
                        android:id="@+id/widget_chart_bar_1"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="26dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:maxHeight="8dp"
                        android:minHeight="8dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_chart"
                        android:rotation="-90" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_chart_day_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="26dp"
                    android:clipChildren="false">

                    <ProgressBar
                        android:id="@+id/widget_chart_bar_2"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="26dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:maxHeight="8dp"
                        android:minHeight="8dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_chart"
                        android:rotation="-90" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_chart_day_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="26dp"
                    android:clipChildren="false">

                    <ProgressBar
                        android:id="@+id/widget_chart_bar_3"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="26dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:maxHeight="8dp"
                        android:minHeight="8dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_chart"
                        android:rotation="-90" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_chart_day_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="26dp"
                    android:clipChildren="false">

                    <ProgressBar
                        android:id="@+id/widget_chart_bar_4"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="26dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:maxHeight="8dp"
                        android:minHeight="8dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_chart"
                        android:rotation="-90" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_chart_day_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="26dp"
                    android:clipChildren="false">

                    <ProgressBar
                        android:id="@+id/widget_chart_bar_5"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="26dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:maxHeight="8dp"
                        android:minHeight="8dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_chart"
                        android:rotation="-90" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_chart_day_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="26dp"
                    android:clipChildren="false">

                    <ProgressBar
                        android:id="@+id/widget_chart_bar_6"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="26dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:maxHeight="8dp"
                        android:minHeight="8dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_chart"
                        android:rotation="-90" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_chart_day_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="8.5sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_remaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:autoSizeMaxTextSize="8.5sp"
            android:autoSizeMinTextSize="6.5sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_tertiary" />

        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_minutes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="8.5sp" />

            <ImageView
                android:id="@+id/widget_progress_link"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:background="@drawable/widget_accent_circle"
                android:contentDescription="@string/widget_open_progress"
                android:padding="4dp"
                android:src="@drawable/ic_widget_arrow"
                android:tint="@color/widget_accent_text" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
