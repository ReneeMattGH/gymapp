<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_brand_mark"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/space_grotesk_bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:text="@string/widget_brand"
            android:textColor="@color/widget_text"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_freshness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_updated_just_now"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="8.5sp" />
    </LinearLayout>

    <TextView
        android:layout_width="1dp"
        android:layout_height="10dp" />

    <TextView
        android:id="@+id/widget_empty_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="27sp"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/space_grotesk_bold"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/widget_empty_title"
        android:textColor="@color/widget_text" />

    <TextView
        android:id="@+id/widget_empty_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/inter_regular"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:maxLines="5"
        android:text="@string/widget_empty_body"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/widget_cta"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_cta"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/widget_cta_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_open_forma"
            android:textColor="@color/widget_accent_ink"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/widget_cta_icon"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="5dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_arrow"
            android:tint="@color/widget_accent_ink" />
    </LinearLayout>

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_disclaimer"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="8sp" />
</LinearLayout>
