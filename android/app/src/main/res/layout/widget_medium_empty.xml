<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_brand_mark"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.16"
                android:text="@string/widget_brand"
                android:textColor="@color/widget_text_secondary"
                android:textSize="8.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/space_grotesk_bold"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/widget_empty_title"
            android:textColor="@color/widget_text" />

        <TextView
            android:id="@+id/widget_empty_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:includeFontPadding="false"
            android:maxLines="3"
            android:text="@string/widget_empty_body_medium"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/widget_cta"
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_cta"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/widget_cta_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_open_forma"
                android:textColor="@color/widget_accent_ink"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/widget_cta_icon"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="5dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_arrow"
                android:tint="@color/widget_accent_ink" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_empty_mark"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="12dp"
        android:alpha="0.35"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />
</LinearLayout>
