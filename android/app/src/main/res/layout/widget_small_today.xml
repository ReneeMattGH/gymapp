<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_brand_mark"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/space_grotesk_bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.16"
            android:text="@string/widget_brand"
            android:textColor="@color/widget_text_secondary"
            android:textSize="8.5sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_state_icon"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:tint="@color/widget_accent_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:textColor="@color/widget_accent_text"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:autoSizeMaxTextSize="21sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:fontFamily="@font/space_grotesk_bold"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/widget_text" />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_regular"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10.5sp" />

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_week_fraction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="10.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_this_week_label"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="9.5sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ProgressBar
            android:id="@+id/widget_week_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:indeterminate="false"
            android:max="100"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_week" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_cta"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_cta"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/widget_cta_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_accent_ink"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/widget_cta_icon"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="5dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:tint="@color/widget_accent_ink" />
    </LinearLayout>
</LinearLayout>
