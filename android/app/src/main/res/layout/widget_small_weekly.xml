<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_brand_mark"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/space_grotesk_bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.16"
            android:text="@string/widget_brand"
            android:textColor="@color/widget_text_secondary"
            android:textSize="8.5sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_state_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:tint="@color/widget_accent_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:text="@string/widget_this_week"
        android:textColor="@color/widget_accent_text"
        android:textSize="9sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_ring"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/widget_text" />

            <TextView
                android:id="@+id/widget_trained"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="6dp"
                android:layout_height="12dp"
                android:clipChildren="false">

                <ProgressBar
                    android:id="@+id/widget_chart_bar_0"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="12dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:max="100"
                    android:maxHeight="5dp"
                    android:minHeight="5dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_chart"
                    android:rotation="-90" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_chart_day_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="6dp"
                android:layout_height="12dp"
                android:clipChildren="false">

                <ProgressBar
                    android:id="@+id/widget_chart_bar_1"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="12dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:max="100"
                    android:maxHeight="5dp"
                    android:minHeight="5dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_chart"
                    android:rotation="-90" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_chart_day_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="6dp"
                android:layout_height="12dp"
                android:clipChildren="false">

                <ProgressBar
                    android:id="@+id/widget_chart_bar_2"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="12dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:max="100"
                    android:maxHeight="5dp"
                    android:minHeight="5dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_chart"
                    android:rotation="-90" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_chart_day_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="6dp"
                android:layout_height="12dp"
                android:clipChildren="false">

                <ProgressBar
                    android:id="@+id/widget_chart_bar_3"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="12dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:max="100"
                    android:maxHeight="5dp"
                    android:minHeight="5dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_chart"
                    android:rotation="-90" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_chart_day_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="6dp"
                android:layout_height="12dp"
                android:clipChildren="false">

                <ProgressBar
                    android:id="@+id/widget_chart_bar_4"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="12dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:max="100"
                    android:maxHeight="5dp"
                    android:minHeight="5dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_chart"
                    android:rotation="-90" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_chart_day_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="6dp"
                android:layout_height="12dp"
                android:clipChildren="false">

                <ProgressBar
                    android:id="@+id/widget_chart_bar_5"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="12dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:max="100"
                    android:maxHeight="5dp"
                    android:minHeight="5dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_chart"
                    android:rotation="-90" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_chart_day_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="6dp"
                android:layout_height="12dp"
                android:clipChildren="false">

                <ProgressBar
                    android:id="@+id/widget_chart_bar_6"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="12dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:max="100"
                    android:maxHeight="5dp"
                    android:minHeight="5dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_chart"
                    android:rotation="-90" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_chart_day_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_link"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_link_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_view_progress"
            android:textColor="@color/widget_accent_text"
            android:textSize="10.5sp" />

        <ImageView
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="3dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_chevron"
            android:tint="@color/widget_accent_text" />
    </LinearLayout>
</LinearLayout>
