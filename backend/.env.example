# Copy to backend/.env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Local development with trust auth (no password) points at a database you own.
# In production use a dedicated role with a strong password and TLS (`?sslmode=require`).
DATABASE_URL=postgres://localhost:5432/forma_dev
# DATABASE_URL=postgres://forma:REPLACE_ME@db.internal:5432/forma?sslmode=require

ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins. The native app is not
# subject to CORS; this only matters if a web client is added later.
CORS_ORIGINS=

# SMTP is required for verification and password-reset email. Without it those
# endpoints answer 503 instead of pretending an email was sent.
# SMTP_URL=smtps://user:REPLACE_ME@mail.example.com:465
MAIL_FROM=Forma <no-reply@example.com>
# Deep-link base used in verification and reset emails.
APP_LINK_BASE=forma://auth

# Community moderators. These email addresses get the admin role in Community;
# every admin route re-checks the signed-in account against this list.
COMMUNITY_ADMIN_EMAILS=

# Where avatar uploads are written and how they are served.
UPLOAD_DIR=./uploads
# Optional absolute origin used to build avatar URLs (e.g. https://api.example.com).
PUBLIC_BASE_URL=

# Run pending migrations when the server starts. Keep false in production and
# run `npm run migrate` as an explicit deploy step.
AUTO_MIGRATE=true

# Number of trusted proxy hops in front of the process (0 when exposed directly).
TRUST_PROXY=0

LOG_LEVEL=info
